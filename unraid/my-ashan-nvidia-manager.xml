<?xml version="1.0"?>
<Container version="2">
  <Name>ashan-nvidia-manager</Name>
  <Repository>ghcr.io/ashanzzz/ashan-nvidia-manager:latest</Repository>
  <Registry>https://github.com/ashanzzz/ashan-nvidia-manager/pkgs/container/ashan-nvidia-manager</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ashanzzz/ashan-nvidia-manager/issues</Support>
  <Project>https://github.com/ashanzzz/ashan-nvidia-manager</Project>
  <ReadMe/>
  <Overview>Ashan NVIDIA Manager。统一多 NVIDIA 账号管理、实时可用性探测、智力评测排名优选，并同步至 New API 独立多渠道。单容器架构集成 Rust 后端、React 前端与 SQLite 存储。</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Ashan NVIDIA Manager Web 管理界面端口" Type="Port" Display="always" Required="true" Mask="false">33332</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/cache/appdata/ashan-nvidia-manager" Mode="rw" Description="SQLite 数据库、配置和持久化数据目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/ashan-nvidia-manager</Config>
  <Config Name="APP_MASTER_KEY" Target="APP_MASTER_KEY" Default="7a3d92f801bc45e2aa1982746352b918f51a418266a8ae905dff90b34bd50c1e" Mode="" Description="用于加密 NVIDIA API Key 和 New API Token。部署后请勿修改。" Type="Variable" Display="advanced-hide" Required="true" Mask="true">7a3d92f801bc45e2aa1982746352b918f51a418266a8ae905dff90b34bd50c1e</Config>
  <Config Name="RUST_LOG" Target="RUST_LOG" Default="info" Mode="" Description="日志级别，正常使用保持 info 即可" Type="Variable" Display="advanced" Required="false" Mask="false">info</Config>
</Container>
